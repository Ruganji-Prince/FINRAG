DATABASE_URL=sqlite:///data/finrag.db
# For PostgreSQL use docker compose and the URLs described in README.
QUERY_DATABASE_URL=
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
API_URL=http://127.0.0.1:8000
INPUT_COST_PER_MILLION=0
OUTPUT_COST_PER_MILLION=0
POSTGRES_PASSWORD=change-this-before-hosting
FINRAG_READER_PASSWORD=change-reader-before-hosting

FINRAG_WRITER_PASSWORD=change-writer-before-hosting
EMBEDDING_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
SEMANTIC_MIN_SIMILARITY=0.30
LOCAL_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# Optional: LLM_PROVIDER=local requires the semantic/model dependencies.
LOCAL_LLM_QUANTIZE=false
PRELOAD_MODELS=false
AUTO_MIGRATE=true

# Required before exposing the API; generate a unique token of at least 32 characters.
PUBLIC_MODE=false
API_ACCESS_TOKEN=
MAX_REQUEST_BYTES=32768
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=2
LOCAL_QUEUE_TIMEOUT_SECONDS=5
